{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@expo/vector-icons": ["node_modules/expo/node_modules/@expo/vector-icons"],
      "@expo/vector-icons/*": ["node_modules/expo/node_modules/@expo/vector-icons/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
